{
  "name": "agenteco-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AgentEco keeper service — permissionless automation for claimExecutionTimeout / finalizeAfterReviewWindow on the deployed AgentEco.sol contract. No user wallets, no reputation logic — the contract remains the source of truth.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start:api": "tsx --env-file-if-exists=.env src/server.ts",
    "dev:host": "tsx watch --env-file-if-exists=.env src/hostMain.ts",
    "start:host": "tsx --env-file-if-exists=.env src/hostMain.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:local": "tsx scripts/localDb.ts",
    "db:local:init": "tsx --env-file-if-exists=.env scripts/localDbInit.ts",
    "seed:sellers": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env scripts/seedDemoSellers.ts",
    "load-test": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env scripts/loadTest.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@electric-sql/pglite-socket": "^0.1.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "playwright-core": "^1.56.1",
    "prisma": "^7.10.0",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.9"
  }
}
