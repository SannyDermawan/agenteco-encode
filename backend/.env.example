# --- Network (shared by the API, host, and keeper — see agent-runtime/src/network.ts) ---
# bsc-testnet (default) | bot-testnet | bot-mainnet. Chain id, RPC and explorer
# come from the preset; every process refuses to start if RPC_URL is on another chain.
NETWORK=bsc-testnet
# Optional — overrides the preset's RPC. It must support eth_getLogs: the
# official BNB data-seed nodes do not, so the default is PublicNode.
RPC_URL=
# Tried in order when RPC_URL fails or times out (comma-separated; "none" = no
# fallback). Default for bsc-testnet: the official data-seed nodes — they refuse
# large eth_getLogs, but reads and transactions keep working.
RPC_FALLBACK_URLS=
# eth_getLogs span per call. Default fits the preset RPC (PublicNode: 50,000).
LOG_RANGE_BLOCKS=
# The deployment. bsc-testnet defaults to this repo's contracts (AgentEco +
# MockUSDT); leave empty unless you redeploy. USDT_ADDRESS = the settlement token.
AGENT_ECO_ADDRESS=
USDT_ADDRESS=

# --- More chains (docs/MULTICHAIN.md) ---
# The chains this backend serves — API, host and keeper — as CAIP-2 ids or network names,
# the default (for requests that name no chain) first. Empty = NETWORK alone, as before.
# e.g. CHAINS=bsc-testnet,base-sepolia
CHAINS=
# Every chain but NETWORK's is configured by the settings above with its CAIP-2 id as a
# suffix (colon written as underscore). A chain without a default deployment needs at least:
#   AGENT_ECO_ADDRESS__eip155_84532=   DEPLOYMENT_BLOCK__eip155_84532=
# and may override RPC_URL__…, RPC_FALLBACK_URLS__…, USDT_ADDRESS__…, LOG_RANGE_BLOCKS__…,
# HOSTED_MIN_GAS__…, LOW_GAS_WARN__….

# --- ERC-8004 (identity and reputation registries; optional, per chain) ---
# Both or neither. Unsuffixed for NETWORK's chain, suffixed for the others
# (ERC8004_IDENTITY_REGISTRY__eip155_84532=…). Not set = no ERC-8004 on that chain.
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
# This API's public URL: agents' ERC-8004 identities point at
# $PUBLIC_API_URL/agents/<id>/registration.json. Without it, hosted agents don't register.
PUBLIC_API_URL=

# --- Timers (seconds; spec §12.2). Defaults are the demo values; production values are noted above each.
# Must fit the contract: windows within [minWindow, 90 days], and seller response +
# arbiter override at most half of disputeTimeout — processes refuse to start otherwise.
# production: 86400
EXECUTION_WINDOW_SECONDS=300
# production: 172800
REVIEW_WINDOW_SECONDS=600
# production: 43200
SELLER_RESPONSE_WINDOW_SECONDS=120
# production: 21600
ARBITER_OVERRIDE_WINDOW_SECONDS=180
# Hosted buyers settle at this AI verification score or more, dispute below it.
VERIFY_ACCEPT_THRESHOLD=60
# The AI arbiter's ruling executes by itself only at this confidence or more.
ARBITER_AUTO_MIN_CONFIDENCE=70
# --- Gas ---
# Least native gas (tBNB) a hosted agent wallet needs before the host runs it.
HOSTED_MIN_GAS=
# Keeper, arbiter and hosted-agent wallets below this log a warning.
LOW_GAS_WARN_TBNB=0.01

# --- Arbiter (host process) ---
# Must be the contract's arbiter (AgentEco.arbiter()). With it, the host
# executes confident AI rulings after the override window; without it (or with
# another address) the AI only recommends and a human rules from the Disputes page.
ARBITER_PRIVATE_KEY=

# --- Keeper ---
# The keeper's own wallet — it only pays gas for the permissionless timeout calls.
KEEPER_PRIVATE_KEY=
KEEPER_POLL_INTERVAL_MS=15000

# Block AgentEco.sol was deployed at — escrow scans start here. bsc-testnet has
# a default; on other networks set it to the contract's deploy block (unset =
# the keeper only sees escrows created after it first starts).
DEPLOYMENT_BLOCK=

# Optional. When true, the keeper logs what it *would* call but never
# sends a transaction. Defaults to false.
DRY_RUN=false

# --- API server (Agent Registry, Discovery, Negotiation, Orders) ---
# From Supabase: Project > Connect > ORMs tab > Prisma.
# DATABASE_URL is the pooled connection (used at runtime by the API).
# DIRECT_URL is the direct connection (used only by `prisma migrate`).
DATABASE_URL=
DIRECT_URL=

# Port the Express API listens on.
API_PORT=4000

# Origin(s) allowed to call the API — comma-separated, e.g.
# https://agenteco.web.id,https://www.agenteco.web.id,https://agenteco-steel.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# --- Hosted buyer agents ("make an agent buy for me") ---
# AES-256-GCM key for encrypting hosted buyer agents' own private keys at
# rest — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Testnet-demo custodial trade-off only — see src/agentKeyCrypto.ts.
AGENT_KEY_ENCRYPTION_SECRET=

# Host runtime (src/hostMain.ts) — separate long-running process, polls for
# active hosted buyer tasks and negotiates/funds/settles for them.
HOST_INTERVAL_MS=5000

# Where the host reaches the API. Leave unset locally (defaults to
# http://localhost:$API_PORT); set it when the API is a separate deployed
# service, e.g. https://agenteco-api.up.railway.app
AGENTECO_API_URL=

# --- AI (spec §6). Keys live only here, on the backend. A provider without a
# key is skipped; with neither, every AI step uses its deterministic fallback.
# Groq: console.groq.com — Gemini: aistudio.google.com
GROQ_API_KEY=
GEMINI_API_KEY=
# Groq model per task (limits count per model, so splitting them adds capacity).
# Verified 2026-09-27 on the free plan: gpt-oss-20b/120b are production,
# qwen3.8-27b is preview. The arbiter must differ from the verifier.
GROQ_MODEL_NEGOTIATION=openai/gpt-oss-20b
GROQ_MODEL_SELLER_DEFENSE=openai/gpt-oss-20b
GROQ_MODEL_EXECUTE=openai/gpt-oss-120b
GROQ_MODEL_VERIFY=qwen/qwen3.8-27b
GROQ_MODEL_ARBITER=openai/gpt-oss-120b
# The fallback model. flash-lite: fast, reliable and the highest free limits;
# gemini-3.8-flash is stronger but often answers 503 "high demand".
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=20000
# On HTTP 429, wait for retry-after up to this many seconds, else switch provider.
LLM_MAX_WAIT_SECONDS=10
LLM_MAX_CALLS_PER_AGENT_PER_HOUR=60
# Optional CoinGecko demo key (the public API works without one).
COINGECKO_API_KEY=
