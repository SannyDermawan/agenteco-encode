generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Registry entry for one agent. On-chain reputation (completedJobs,
// successRate, etc.) is NOT duplicated here — the deployed AgentEco.sol
// contract remains the sole source of truth for that; the frontend reads
// it live via walletAddress using its existing wagmi hooks.
model Agent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The chain this listing trades on (CAIP-2, e.g. eip155:97). One row per agent per chain:
  // its wallet, prices and escrows are that chain's.
  chainId        String   @map("chain_id")
  // The person this agent is linked to (an approved device link, see DeviceLink): the wallet that
  // may manage it from the website and whose agents count as "the same owner" in ratings. The
  // agent's own wallet stays ownerWallet; null = not linked to anyone.
  accountWallet  String?  @map("account_wallet")
  // Links the rows of one logical agent across chains (set by its owner; null = standalone).
  groupId        String?  @map("group_id") @db.Uuid
  // ERC-8004 identity on this chain (IdentityRegistry token id), once registered.
  erc8004AgentId String?  @map("erc8004_agent_id")
  name           String
  description    String
  role           String
  category       String?
  service        String?
  capabilities   String[] @default([])
  price          Decimal  @db.Decimal
  minimumPrice   Decimal? @map("minimum_price") @db.Decimal
  maxBudget      Decimal? @map("max_budget") @db.Decimal
  walletAddress  String?  @map("wallet_address")
  endpoint       String?
  inputSchema    Json?    @map("input_schema")
  outputSchema   Json?    @map("output_schema")
  isOnline       Boolean  @default(false) @map("is_online")
  ownerWallet    String   @map("owner_wallet")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --- Hosted buyer task (§ brainstorm: "make an agent buy for me") ---
  // Only set for an agent AgentEco itself runs on the owner's behalf (a
  // hosted buyer task, or a hosted seller — see below). NULL for
  // everything else (self-custody sellers, and the standalone buyer-agent/
  // seller-agent processes, which self-custody their own keys in their own
  // .env instead). agentWalletKey is this agent's OWN private key —
  // AES-256-GCM encrypted with AGENT_KEY_ENCRYPTION_SECRET, never plaintext.
  // A hackathon-appropriate custodial trade-off: fine for testnet-only
  // demo funds, never acceptable for real value without a proper KMS.
  agentWalletKey   String? @map("agent_wallet_key")
  taskStatus       String? @map("task_status") // awaiting_deposit | active | completed | refunded
  depositorWallet  String? @map("depositor_wallet")
  minSuccessRate   Int?    @map("min_success_rate") // basis-points-free integer percent (0-100); null = "Recommended", no filter
  minCompletedJobs Int?    @map("min_completed_jobs")
  minReputation    Int?    @map("min_reputation")

  // --- Hosted seller agent ---
  // Reuses agentWalletKey / taskStatus (awaiting_deposit | active) /
  // depositorWallet (where settled earnings get swept to) from above.
  // escrowScanBlock is the chain head when the agent was created — the host
  // runtime scans EscrowCreated events naming this seller from here onward.
  escrowScanBlock BigInt? @map("escrow_scan_block")

  // Soft delete — orders and negotiations keep pointing at this row, so it
  // is never hard-deleted. Set = hidden from listings and ignored by the host.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // --- AI agents (spec §8.1) ---
  // Seller: style/focus preferences for its model (≤500 chars); never changes
  // the output schema or safety rules.
  customInstructions String? @map("custom_instructions")
  // Hosted buyer: what to buy — a brief matching its capability's input
  // schema — and what a good result must satisfy (≤500 chars).
  taskBrief          Json?   @map("task_brief")
  acceptanceCriteria String? @map("acceptance_criteria")

  // --- Self-hosted agents (Register Own Agent) ---
  // The last heartbeat from a self-hosted agent's own process (the SDK sends one
  // every poll). A self-hosted seller counts as online only while it keeps beating:
  // maintenance.ts takes it offline when the heartbeats stop.
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)

  // --- Moderation (reports, decided by the arbiter council) ---
  // Set = delisted: hidden from the marketplace and from discovery, and no new
  // negotiations. Deals already in escrow still finish. The owner can appeal.
  delistedAt   DateTime? @map("delisted_at") @db.Timestamptz(6)
  delistReason String?   @map("delist_reason")

  negotiationsAsBuyer  Negotiation[] @relation("BuyerAgent")
  negotiationsAsSeller Negotiation[] @relation("SellerAgent")
  ordersAsBuyer        Order[]       @relation("OrderBuyerAgent")
  ordersAsSeller       Order[]       @relation("OrderSellerAgent")
  reports              Report[]
  appeals              Appeal[]

  @@index([chainId, role])
  @@index([groupId])
  @@index([accountWallet])
  @@map("agents")
}

// One Offer -> Counter Offer -> Accept/Reject session between two agents
// over a single capability (§11). Negotiation messages stay off-chain —
// only the agreed price, once accepted, feeds into creating an order/escrow
// (Phase 6+). Nothing here is on-chain.
model Negotiation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerAgentId  String   @map("buyer_agent_id") @db.Uuid
  sellerAgentId String   @map("seller_agent_id") @db.Uuid
  // Buyer and seller trade on the same chain; the deal is escrowed there.
  chainId       String   @map("chain_id")
  capability    String
  // open | accepted | rejected | expired (the side whose turn it was went silent; see maintenance.ts)
  status        String   @default("open")
  agreedPrice   Decimal? @map("agreed_price") @db.Decimal
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyerAgent  Agent                @relation("BuyerAgent", fields: [buyerAgentId], references: [id])
  sellerAgent Agent                @relation("SellerAgent", fields: [sellerAgentId], references: [id])
  messages    NegotiationMessage[]
  order       Order?

  @@map("negotiations")
}

model NegotiationMessage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negotiationId String   @map("negotiation_id") @db.Uuid
  side          String // buyer | seller
  action        String // offer | counter | accept | reject
  price         Decimal? @db.Decimal
  // Why this offer (≤280 chars, English) — from the model, or null for rule-based moves.
  reason        String?
  // ai | rule (AgentEco's hosted agents) | agent (a self-hosted agent's own logic)
  source        String   @default("rule")
  // True when a guardrail clamped the model's price to a limit.
  adjusted      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  negotiation Negotiation @relation(fields: [negotiationId], references: [id])

  @@map("negotiation_messages")
}

// Created automatically the moment a negotiation is accepted (§2/§26:
// "Order dapat dibuat tanpa human orchestration"). `status` only tracks
// the pre-chain handoff itself:
//   agreed -> a deal exists, not funded on-chain yet
//   funded -> escrowId is set; AgentEco.sol is the source of truth for
//             everything from here on (executing/delivered/settled/etc.),
//             read live via wagmi — not mirrored into this row.
model Order {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  negotiationId String   @unique @map("negotiation_id") @db.Uuid
  buyerAgentId  String   @map("buyer_agent_id") @db.Uuid
  sellerAgentId String   @map("seller_agent_id") @db.Uuid
  chainId       String   @map("chain_id")
  capability    String
  price         Decimal  @db.Decimal
  status        String   @default("agreed") // agreed | funded
  escrowId      String?  @map("escrow_id")
  taskId        String?  @unique @map("task_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  negotiation Negotiation @relation(fields: [negotiationId], references: [id])
  task        Task?       @relation(fields: [taskId], references: [id])
  buyerAgent  Agent       @relation("OrderBuyerAgent", fields: [buyerAgentId], references: [id])
  sellerAgent Agent       @relation("OrderSellerAgent", fields: [sellerAgentId], references: [id])

  @@unique([chainId, escrowId])
  @@map("orders")
}

// The actual task output — keyed by on-chain escrowId directly (not order
// id), since a seller can be hired either through a negotiated Order or a
// direct "Request Service" on-chain hire with no Order row at all. Only the
// *hash* of this content is ever written on-chain (markDelivered); this
// table is what lets a buyer actually read the result instead of just a
// hash they can't do anything with. Writing here requires the hash to
// already match what's on-chain for that escrow — see routes/escrowResults.ts.
model EscrowResult {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The chain the escrow lives on, as a CAIP-2 id (eip155:97 = BSC Testnet). Escrow ids are
  // numbered per chain (per deployment), so every escrow-keyed row is unique per (chainId, escrowId).
  chainId    String   @map("chain_id")
  escrowId   String   @map("escrow_id")
  capability String
  result     Json
  // The exact string whose keccak256 is the on-chain resultHash (jsonb
  // reorders keys, so `result` alone can't reproduce the hash).
  resultJson String?  @map("result_json")
  resultHash String   @map("result_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([chainId, escrowId])
  @@map("escrow_results")
}

// The task behind an escrow (spec §5): the buyer's brief and acceptance
// criteria for a capability, plus price and parties. `preimage` is the exact
// JSON string whose keccak256 is the escrow's on-chain taskHash — anyone can
// re-hash it. Stored before createEscrow (pending), then linked to the escrow
// once the API has checked the on-chain taskHash, buyer, seller and amount.
// Negotiated orders and direct hires both point here.
model Task {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chainId    String   @map("chain_id")
  capability String
  brief      Json
  criteria   String   @default("")
  price      String // normalized decimal string, exactly as hashed
  buyer      String // lowercase address
  seller     String // lowercase address
  nonce      String
  preimage   String
  taskHash   String   @unique @map("task_hash")
  escrowId   String?  @map("escrow_id")
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order?

  @@unique([chainId, escrowId])
  @@map("tasks")
}

// A hosted buyer's AI check of a delivered result (spec §10.1). score ≥
// VERIFY_ACCEPT_THRESHOLD settles, below raises a dispute. provider "none"
// marks the fallback (AI unavailable → settle without rating).
model Verification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The chain the escrow lives on, as a CAIP-2 id (eip155:97 = BSC Testnet). Escrow ids are
  // numbered per chain (per deployment), so every escrow-keyed row is unique per (chainId, escrowId).
  chainId   String   @map("chain_id")
  escrowId  String   @map("escrow_id")
  // Null when no model answered (provider "none": accepted unscored, not rated).
  score     Int?
  verdict   String // accept | dispute
  rationale String
  provider  String
  model     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([chainId, escrowId])
  @@map("verifications")
}

// SellerRated events, indexed from the chain (spec §10.3). sameOwner marks
// ratings between two agents of one owner wallet — kept for the raw view but
// left out of displayed reputation and seller selection.
model Rating {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The chain the escrow lives on, as a CAIP-2 id (eip155:97 = BSC Testnet). Escrow ids are
  // numbered per chain (per deployment), so every escrow-keyed row is unique per (chainId, escrowId).
  chainId           String   @map("chain_id")
  escrowId          String   @map("escrow_id")
  seller            String // lowercase
  buyer             String // lowercase
  score             Int
  source            String // ai (buyer is a hosted agent) | user
  sameOwner         Boolean  @map("same_owner")
  txHash            String?  @map("tx_hash")
  // The buyer's ERC-8004 feedback for this deal (Reputation Registry), when it gave one.
  erc8004FeedbackTx String?  @map("erc8004_feedback_tx")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([chainId, escrowId])
  @@index([seller])
  @@map("ratings")
}

// A dispute's whole off-chain trail (spec §11), keyed by escrowId. Every text
// has its hash on-chain (reasonHash, responseHash, resolutionHash); the API
// only accepts a text whose hash matches the chain.
model Dispute {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The chain the escrow lives on, as a CAIP-2 id (eip155:97 = BSC Testnet). Escrow ids are
  // numbered per chain (per deployment), so every escrow-keyed row is unique per (chainId, escrowId).
  chainId     String @map("chain_id")
  escrowId    String @map("escrow_id")
  buyerWallet String @map("buyer_wallet")

  reason     String
  reasonHash String @map("reason_hash")

  sellerResponse String?   @map("seller_response")
  responseHash   String?   @map("response_hash")
  responseSource String?   @map("response_source") // ai | manual | api
  respondedAt    DateTime? @map("responded_at") @db.Timestamptz(6)

  // AI arbiter recommendation (null fields = not run yet; recUnavailable = AI failed).
  recVerdict       String?   @map("rec_verdict") // seller | buyer
  recConfidence    Int?      @map("rec_confidence")
  recRationale     String?   @map("rec_rationale")
  recProvider      String?   @map("rec_provider")
  recModel         String?   @map("rec_model")
  recommendedAt    DateTime? @map("recommended_at") @db.Timestamptz(6)
  recUnavailable   Boolean   @default(false) @map("rec_unavailable")
  overrideDeadline DateTime? @map("override_deadline") @db.Timestamptz(6)

  // Final outcome. rationalePreimage is the exact JSON whose hash is on-chain.
  resolution        String? // ai-auto | arbiter-manual | timeout
  releasedToSeller  Boolean?  @map("released_to_seller")
  rationalePreimage String?   @map("rationale_preimage")
  rationaleHash     String?   @map("rationale_hash")
  resolutionTx      String?   @map("resolution_tx")
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([chainId, escrowId])
  @@map("disputes")
}

/**
 * One row per AI provider attempt (and per fallback), for the load test's
 * 429 / fallback counts and for spotting a struggling provider. Never the
 * prompt or the answer — only what happened.
 */
model AiCall {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task      String // negotiation | execute | verify | seller_defense | arbiter
  provider  String // groq | gemini | none
  model     String?
  outcome   String // ok | invalid | rate_limited | error | fallback | over_budget
  ms        Int?
  agentId   String?  @map("agent_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("ai_calls")
}

// A person approving an agent's key as theirs, in a browser, with their own wallet (agent side:
// `agenteco init`). Pending until approved or expired; only a hash of the device secret is kept.
// The agent proves control of its key when it creates the link; the person proves theirs when
// approving (an EIP-4361 message naming the code, the agent wallet and the chain).
model DeviceLink {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The short code the person types, "K7QP-M2XD".
  userCode    String    @unique @map("user_code")
  agentWallet String    @map("agent_wallet")
  chainId     String    @map("chain_id")
  role        String // buyer | seller
  label       String
  secretHash  String    @map("secret_hash")
  status      String    @default("pending") // pending | approved | denied
  ownerWallet String?   @map("owner_wallet")
  /// Wrong approval attempts; the link is denied after a few.
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([agentWallet])
  @@map("device_links")
}

// An approved link: this agent wallet belongs to this person. It carries no spending authority
// either way. Revoked by the person (revokedAt); agents keep working, just unlinked.
model AccountLink {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentWallet String    @unique @map("agent_wallet") // lowercase
  ownerWallet String    @map("owner_wallet") // lowercase
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([ownerWallet])
  @@map("account_links")
}

// Open capability registry: a capability a developer published, beyond the
// four platform ones (agent-runtime/src/shared/capabilities/definitions.ts).
// Self-hosted sellers offer it; briefs and results are checked against its
// JSON Schemas. Immutable once published — tasks commit to it.
model Capability {
  id           String   @id
  name         String
  description  String
  category     String
  inputSchema  Json     @map("input_schema")
  outputSchema Json     @map("output_schema")
  rubric       String
  /// Worked examples: [{ title, input, output }]. Validated against the schemas at publish time.
  examples     Json     @default("[]")
  ownerWallet  String   @map("owner_wallet")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("capabilities")
}

// A wallet reports a seller listing (scam, fake results, spam, harmful). The
// arbiter council votes on it (ModerationVote): enough "delist" votes delist the
// agent, enough "dismiss" votes close the report.
model Report {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId        String    @map("agent_id") @db.Uuid
  reporterWallet String    @map("reporter_wallet")
  category       String // fake_results | scam | spam | harmful | other
  reason         String
  /// The reporter once hired this seller (stronger evidence).
  hadOrder       Boolean   @default(false) @map("had_order")
  status         String    @default("open") // open | delisted | dismissed
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)

  agent Agent @relation(fields: [agentId], references: [id])

  @@index([agentId, status])
  @@index([reporterWallet, createdAt])
  @@map("reports")
}

// A delisted agent's owner asks the council to reinstate it.
model Appeal {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId     String    @map("agent_id") @db.Uuid
  ownerWallet String    @map("owner_wallet")
  reason      String
  status      String    @default("open") // open | reinstated | upheld
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)

  agent Agent @relation(fields: [agentId], references: [id])

  @@index([agentId, status])
  @@map("appeals")
}

// One council member's vote on a report (delist | dismiss) or an appeal
// (reinstate | uphold). The council's admin threshold decides.
model ModerationVote {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseType    String   @map("case_type") // report | appeal
  caseId      String   @map("case_id") @db.Uuid
  voterWallet String   @map("voter_wallet")
  vote        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([caseType, caseId, voterWallet])
  @@map("moderation_votes")
}
