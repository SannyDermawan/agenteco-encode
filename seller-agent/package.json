{
  "name": "agenteco-seller-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted seller agents built on the AgentEco SDK (agent-runtime/src/sdk): a CSV stats seller (npm start) and a community-capability seller (npm run sentiment).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "sentiment": "tsx --env-file=.env src/sentiment.ts",
    "sentiment:solana": "tsx --env-file=.env src/sentiment-solana.ts",
    "new-key": "tsx scripts/new-key.ts",
    "translator": "tsx --env-file=.env src/translator.ts"
  },
  "dependencies": {
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  }
}
