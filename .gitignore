# Safety net on top of each package's own .gitignore.

# dependencies / builds
node_modules/
.next/
out/
build/
*.tsbuildinfo

# secrets — only the .example templates are committed
.env
.env.*
!.env.example

# Foundry build artifacts (out/ is covered above); broadcast/ keeps real deployments, not dry runs
cache/
broadcast/**/dry-run/

# local agent / keeper checkpoints
*-state.json
.keeper-state.json

# local tooling
.claude/settings.local.json
.DS_Store
*.log

# local end-to-end scripts (may use real testnet keys via env)
*.local.ts
*.local.mjs

# Python
__pycache__/
*.pyc
# build output and the program keypair (a secret)
solana/target/
