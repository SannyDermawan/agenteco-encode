# AgentEco backend API (the Railway "api" service in production).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Network (see lib/web3/network.ts) ---
# bsc-testnet (default) | bot-testnet | bot-mainnet. Chain id, RPC, explorer,
# token symbol and faucet links come from the preset.
NEXT_PUBLIC_NETWORK=bsc-testnet
# Optional — overrides the preset's RPC. It must support eth_getLogs (the
# official BNB data-seed nodes do not; the default is PublicNode).
NEXT_PUBLIC_RPC_URL=
# Tried when NEXT_PUBLIC_RPC_URL fails (comma-separated; "none" = no fallback).
NEXT_PUBLIC_RPC_FALLBACK_URLS=
# The deployment. bsc-testnet defaults to this repo's AgentEco + MockUSDT;
# a BUILD FAILS for other networks without NEXT_PUBLIC_AGENT_ECO_ADDRESS and
# NEXT_PUBLIC_DEPLOY_BLOCK.
NEXT_PUBLIC_AGENT_ECO_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=

# --- Solana (see lib/web3/network.ts) ---
# Offer a Solana network next to the EVM ones: NEXT_PUBLIC_CHAINS lists the networks the app offers (names or
# CAIP-2 ids, the default first; unset = NEXT_PUBLIC_NETWORK alone), e.g. NEXT_PUBLIC_CHAINS=solana-devnet,bsc-testnet
# The escrow program has no default deployment: the BUILD FAILS for solana-devnet without it. The suffix is the
# chain's CAIP-2 id with the colon as an underscore.
NEXT_PUBLIC_CHAINS=
NEXT_PUBLIC_AGENT_ECO_PROGRAM__solana_EtWTRABZaYq6iMfeYKouRu166VU2xqa1=
# Settlement token (default: Circle's devnet USDC), RPC (default: the public devnet RPC — expect rate limits;
# use your own provider for a demo) and the first escrow id the program numbers from (default 1).
NEXT_PUBLIC_TOKEN_MINT__solana_EtWTRABZaYq6iMfeYKouRu166VU2xqa1=
NEXT_PUBLIC_RPC_URL__solana_EtWTRABZaYq6iMfeYKouRu166VU2xqa1=
NEXT_PUBLIC_RPC_FALLBACK_URLS__solana_EtWTRABZaYq6iMfeYKouRu166VU2xqa1=
NEXT_PUBLIC_FIRST_ESCROW_ID__solana_EtWTRABZaYq6iMfeYKouRu166VU2xqa1=

# --- Timers (seconds). Defaults are the demo values; production values are noted above each.
# production: 86400
NEXT_PUBLIC_EXECUTION_WINDOW_SECONDS=300
# production: 172800
NEXT_PUBLIC_REVIEW_WINDOW_SECONDS=600
# true = "Demo mode — timers shortened" banner and live countdowns.
NEXT_PUBLIC_DEMO_MODE=true

# --- Gas ---
# Below this tBNB balance the app asks for gas first and disables the mUSDT claim.
NEXT_PUBLIC_MIN_TBNB=0.002
# tBNB sent to a hosted agent's own wallet when it is activated.
NEXT_PUBLIC_AGENT_GAS_TOPUP=

# All NEXT_PUBLIC_* values are baked in at build time — change one, then redeploy.
