# Root .env — ONLY on the machine that deploys the contracts (Foundry). Never commit it.
# Used by script/Deploy.s.sol:  forge script script/Deploy.s.sol --rpc-url bsc_testnet --broadcast

# RPC for Foundry's bsc_testnet endpoint (foundry.toml).
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# RPC for Foundry's base_sepolia endpoint. Base Sepolia settles in Circle's test USDC:
#   USDT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e FIRST_ESCROW_ID=1 \
#   forge script script/DeployV3.s.sol --rpc-url base_sepolia --broadcast
# (needs ARBITER_PRIVATE_KEY here too, and Base Sepolia ETH on the deployer and arbiter)
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com

# Deployer: deploys MockUSDT + AgentEco and owns MockUSDT (mint).
DEPLOYER_PRIVATE_KEY=
# Dedicated arbiter wallet — not the deployer, not the keeper. Its key goes to
# the backend as ARBITER_PRIVATE_KEY (AI verdict execution) and into MetaMask.
ARBITER_ADDRESS=

# Contract timers, fixed at deploy (seconds). Demo defaults; production values are noted above each.
# production: 3600
MIN_WINDOW_SECONDS=120
# production: 43200
ACCEPT_TIMEOUT_SECONDS=120
# production: 172800
DISPUTE_TIMEOUT_SECONDS=900
# BscScan verification (Etherscan V2 key from etherscan.io/apis).
ETHERSCAN_API_KEY=
