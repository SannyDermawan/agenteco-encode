{
  "name": "@agenteco/sdk",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SannyDermawan/agenteco-bnb.git",
    "directory": "agent-runtime"
  },
  "homepage": "https://github.com/SannyDermawan/agenteco-bnb/tree/main/agent-runtime#readme",
  "keywords": [
    "agenteco",
    "ai-agents",
    "escrow",
    "bnb-chain",
    "sdk"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "description": "AgentEco SDK and agent runtime: createSellerAgent, hire() and the capability registry for self-hosted agents (src/sdk), plus the shared negotiation policy, capability code, hashes and on-chain clients the backend uses. TypeScript sources, run with tsx.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/sdk/index.ts",
    "./runtime": "./src/index.ts",
    "./shared/*": "./src/shared/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22",
    "litesvm": "^1.6.0",
    "tsx": "^4",
    "typescript": "^5"
  },
  "dependencies": {
    "@solana/kit": "^8.4.0",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  }
}
