  "type": "module",
  "bin": { "agenteco": "dist/cli.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22.9" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@solana/kit": "^8.4.0",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5"
  }
}
