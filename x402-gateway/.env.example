# Copy to .env (git-ignored). Names only here, never real values.
PORT=8402
# The Solana address that receives the payments (a public address, not a key).
PAY_TO_ADDRESS=
# Solana devnet by default. CAIP-2 id.
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# Default is the public test facilitator.
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_FACILITATOR_TIMEOUT_MS=15000
# Optional: a JSON file where the payment ledger is kept between restarts.
LEDGER_FILE=

# Optional: any OpenAI-compatible model (Nebius Token Factory, Groq, ...). With all three set the gateway also sells a `translate` agent.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# pay-demo only (a devnet wallet that holds devnet USDC). base58 secret key, never commit.
SVM_PRIVATE_KEY=
GATEWAY_URL=http://localhost:8402
