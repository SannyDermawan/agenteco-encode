{
  "name": "x402-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Pay-per-call gateway for AgentEco agents using x402 on Solana devnet.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "pay-demo": "tsx --env-file-if-exists=.env scripts/pay-demo.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@x402/core": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "express": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
